# Copy to .env and export these (or set them in your process manager). All are optional.
FRAUD_SHIELD_ENV=development        # development | demo | production
FRAUD_SHIELD_DB=data/shield.db
# FRAUD_SHIELD_API_KEY=change-me    # require an X-API-Key header on every write endpoint
# FRAUD_SHIELD_RATE_LIMIT=120       # write requests per minute per client IP (0 = off)
# FRAUD_SHIELD_CORS=https://console.example.com
# FRAUD_SHIELD_MAX_BATCH=500
# FRAUD_SHIELD_RETENTION=10000
# FRAUD_SHIELD_LOG_LEVEL=INFO
